{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/jobs/process.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/webhook/agentphone",
      "destination": "/api/webhook/agentphone"
    }
  ]
}
