AGENTPHONE_API_KEY=your_api_key_here
AGENTPHONE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
AGENTPHONE_WEBHOOK_URL=https://fasttab.cc/webhook/agentphone
AGENTPHONE_AGENT_NAME=Fasttab Agent
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_PROVISION_NUMBER=false
PORT=3000

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_API_BASE=https://api.agentmail.to
AGENTMAIL_INBOX_ID=

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_API_BASE=https://api.stripe.com

# Sponge
SPONGE_API_KEY=
SPONGE_AGENT_ID=
SPONGE_AGENT_NAME=Fasttab Foodrun Agent
SPONGE_API_BASE=https://api.wallet.paysponge.com
SPONGE_FOOD_ORDER_CARD_AMOUNT_USD=75
SPONGE_DAILY_SPENDING_LIMIT_USD=
SPONGE_WEEKLY_SPENDING_LIMIT_USD=
SPONGE_MONTHLY_SPENDING_LIMIT_USD=

# Supermemory
SUPERMEMORY_API_KEY=
SUPERMEMORY_API_BASE=https://api.supermemory.ai

# AgentPhone (optional — for texting payment links)
AGENTPHONE_API_BASE=https://api.agentphone.ai
AGENTPHONE_PHONE_NUMBER=

# Browser Use
BROWSER_USE_API_KEY=
BROWSER_USE_API_BASE=https://api.browser-use.com/api/v3
BROWSER_USE_MODEL=claude-sonnet-4.6
# Cart build Browser Use session timeout in ms (default 240000; official direct brands use 210000)
BROWSER_USE_CART_TIMEOUT_MS=240000

# Restaurant availability discovery
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Neon
DATABASE_URL=

# Foodrun safety
FOODRUN_CHECKOUT_MODE=dry_run
# Hackathon SMS demo: stub restaurant/cart, skip Browser Use and open-hours checks
FOODRUN_DEMO_MODE=true
FOODRUN_JOB_SECRET=
# Insomnia Cookies: built-in demo menu cart (`false` disables; official checkout still happens on insomniacookies.com)
FOODRUN_INSOMNIA_CATALOG_CART=true
